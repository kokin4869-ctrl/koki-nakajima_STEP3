body{
   margin: 0;
   font-family: "Yu Gothic", sans-serif;
   line-height: 1.6;
   background-color: #f5f5f5;
}
header{
   background-color: #3f774d;
   color: white;
   padding: 20px;
   text-align: center;
}
nav ul{
   list-style: none;
   padding: 0;
   display: flex;
   justify-content: center;
   gap: 20px;
}
nav a{
   color: white;
   text-decoration: none;
}

nav a:hover{
   color: #c8e6c9;
}
section{
   padding: 40px 20px;
   text-aling: center;
}
h2{
    display: inline-block;
    border-bottom: 2px solid #c8e6c9;
    padding-bottom: 5px;
}
img{
   border-radius: 10px
}
.menu-list{
   display: flex;
   justify-content: center;
   gap: 20px;
}
.menu-item{
    background-color: white;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 2px 5px #ccc;
}
.menu-item:hover{
    transform: translateY(-5px);
    box-shadow: 0 4px 10px #aaa;
}
input, textarea{
    width: 300px;
    padding: 10px;
    box-sizing: border-box;
}
button{
    width: 300px;
    padding: 10px;
    background-color: #3f774d;
    color: white;
    border: none;
}
button:hover{
    background-color: #2f5f3b;
}
footer{
    background-color: #2f5f3b;
    color: white;
    text-align: center;
    padding: 20px;
}
.menu-list{
    display: flex;
    justify-content: center;
    gap: 20px;
}

